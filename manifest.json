{
  "manifest_version": 2,
  "name": "Media Fit",
  "version": "1.0.0",
  "description": "Removes black bars built into web videos in fullscreen, without cutting the picture or losing subtitles.",
  "icons": { "96": "icon.svg" },
  "browser_specific_settings": {
    "gecko": {
      "id": "media-fit@milindmgowda",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage"],
  "browser_action": {
    "default_title": "Media Fit",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
